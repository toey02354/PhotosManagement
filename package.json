{
  "name": "photos-management",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Desktop tool for renaming photos, organizing Live Photos, and restoring metadata from originals.",
  "main": "dist-electron/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.1.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^3.2.7"
  }
}
